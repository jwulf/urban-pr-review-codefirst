{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["esnext", "dom"],
    "types": ["node"]
  },
  "include": ["main.ts", "workflows/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
