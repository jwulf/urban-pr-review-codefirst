{
  "name": "@nanobpm/urban-pr-review-codefirst",
  "version": "1.1.0",
  "description": "Code-first (defineFlow) expression of the Nano Urban PR-review convergence app: one durable multi-round loop per PR, BPMN model derived from TypeScript.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "main": "main.ts",
  "author": "Josh Wulf <josh.wulf@camunda.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/jwulf/urban-pr-review-codefirst#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jwulf/urban-pr-review-codefirst.git"
  },
  "bugs": {
    "url": "https://github.com/jwulf/urban-pr-review-codefirst/issues"
  },
  "keywords": [
    "nano-ide-ext",
    "nano-ide-agentic-sdlc"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node --experimental-strip-types main.ts",
    "purge": "node --experimental-strip-types scripts/purge-db.ts",
    "check": "urban check",
    "gen": "urban gen",
    "gen:check": "urban gen --check",
    "dev": "urban dev",
    "submit": "node --experimental-strip-types scripts/submit.ts",
    "review-ready": "node --experimental-strip-types scripts/review-ready.ts",
    "answer": "node --experimental-strip-types scripts/answer.ts",
    "compile": "deno task compile"
  },
  "dependencies": {
    "@nanobpm/urban": "^0.16.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "semantic-release": "^24.2.9",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.5"
  },
  "overrides": {
    "@semantic-release/npm": "^13.1.5"
  }
}
