{
  "compilerOptions": {
    "lib": ["deno.window", "deno.ns", "esnext", "dom"]
  },
  "lint": {
    "exclude": [".deno-cache/", "nano-generated/"]
  },
  "imports": {
    "@nanobpm/urban": "npm:@nanobpm/urban@^0.17.1"
  },
  "tasks": {
    "start": "deno run --allow-net --allow-read --allow-write --allow-run=gh --allow-env main.ts",
    "purge": "deno run --allow-read --allow-write --allow-env scripts/purge-db.ts",
    "check": "deno run -A @nanobpm/urban check",
    "gen": "deno run -A @nanobpm/urban gen",
    "gen:check": "deno run -A @nanobpm/urban gen --check",
    "dev": "deno run -A @nanobpm/urban dev",
    "submit": "deno run --allow-net --allow-read --allow-env scripts/submit.ts",
    "review-ready": "deno run --allow-net --allow-read --allow-env scripts/review-ready.ts",
    "answer": "deno run --allow-net --allow-read --allow-env scripts/answer.ts",
    "compile": "deno compile --allow-net --allow-read --allow-write --allow-run=gh --allow-env -o dist/urban-pr-review-codefirst main.ts"
  }
}
